<table class="table table-cv table-sm table-borderless table-responsive table-cv-map">
  {% assign skip_basics = 'image,profiles,location' | split: ',' %}
  {% for content in site.data.resume.basics %}
    {% if skip_basics contains content[0] or content[1] == "" %}
      {% continue %}
    {% endif %}

    <tr>
      <td class="p-1 pr-2 font-weight-medium">
        {% case content[0] %}
          {% when 'name' %} Name
          {% when 'label' %} Title
          {% when 'email' %} Email
          {% when 'phone' %} Phone
          {% when 'url' %} Website
          {% else %} {{ content[0] | capitalize }}
        {% endcase %}
      </td>
      <td class="p-1 pl-2 font-weight-light text">
        {% if content[0] == 'url' %}
          <a href="{{ content[1] }}" target="_blank" rel="noopener noreferrer">
            {{ content[1] | remove: "https://" | remove: "http://" | remove: "/" }}        {% elsif content[0] == 'email' %}
          <a href="mailto:{{ content[1] }}" target="_blank">{{ content[1] }}</a>
        {% elsif content[0] == 'phone' %}
          <a href="tel:{{ content[1] }}">{{ content[1] }}</a>
        {% else %}
          {{ content[1] }}
        {% endif %}
      </td>
    </tr>
  {% endfor %}

  {% if site.data.resume.basics.profiles %}
    {% for profile in site.data.resume.basics.profiles %}
      <tr>
        <td class="p-1 pr-2 font-weight-medium">
          {{ profile.network }}
        </td>
        <td class="p-1 pl-2 font-weight-light text">
          <a href="{{ profile.url }}" target="_blank" rel="noopener noreferrer">{{ profile.username }}</a>
        </td>
      </tr>
    {% endfor %}
  {% endif %}
</table>
